compiler: "arm-clang";

loop "dijkstra::dijkstra_find.L1" { bound: 100 .. 100; }
loop "dijkstra::dijkstra_find.L2" { bound: 100 .. 1000; }
loop "dijkstra::dijkstra_find.L3" { bound: 100 .. 100; }

loop "dijkstra::dijkstra_enqueue.L1" { bound: 0 .. 1000; }

loop "dijkstra::dijkstra_main.L1" { bound: 20 .. 20; }

# code should not panic and as such there should be no need for unwinding
loop "__rustc::rust_begin_unwind.L1" infeasible;
