compiler: "arm-clang";

loop "cjpeg_wrbmp::cjpeg_wrbmp_write_colormap.L1" { bound: 256 .. 256; }
loop "cjpeg_wrbmp::cjpeg_wrbmp_write_colormap.L2" { bound: 512 .. 512; }
loop "cjpeg_wrbmp::cjpeg_wrbmp_write_colormap.L3" { bound: 256 .. 256; }
loop "cjpeg_wrbmp::cjpeg_wrbmp_write_colormap.L4" { bound: 256 .. 256; }

loop "cjpeg_wrbmp::cjpeg_wrbmp_finish_output_bmp.L1" { bound: 30 .. 30; }

# code should not panic and as such there should be no need for unwinding
loop "__rustc::rust_begin_unwind.L1" infeasible;
