compiler: "arm-clang";

loop "petrinet::petrinet_main.L1" { bound: 2 .. 2; }
loop "petrinet::petrinet_main.L2" { bound: 6 .. 6; }
loop "petrinet::petrinet_main.L3" { bound: 20 .. 20; }

# code should not panic and as such there should be no need for unwinding
loop "__rustc::rust_begin_unwind.L1" infeasible;
