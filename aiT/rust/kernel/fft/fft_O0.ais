compiler: "arm-clang";

loop "fft::fft_bit_reduct.L1" { bound: 1024 .. 1024; }
loop "fft::fft_bit_reduct.L2" { bound: 10 .. 10; }
loop "fft::fft_bit_reduct.L3" { bound: 1 .. 512; }
loop "fft::fft_bit_reduct.L4" { bound: 2048 .. 2048; }
loop "fft::fft_bit_reduct.L5" { bound: 1 .. 512; }

# code should not panic and as such there should be no need for unwinding
loop "__rustc::rust_begin_unwind.L1" infeasible;
