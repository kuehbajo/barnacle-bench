compiler: "arm-clang";

loop "cubic_custom::cubic_main.L2" { bound: 0 .. 5; }
loop "cubic_custom::cubic_main.L3" { bound: 0 .. 7; }
loop "cubic_custom::cubic_main.L4" { bound: 0 .. 5; }

# code should not panic and as such there should be no need for unwinding
loop "__rustc::rust_begin_unwind.L1" infeasible;