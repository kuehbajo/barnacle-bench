compiler: "arm-clang";

loop "minver::minver_main.L1" { bound: 0 .. 3; }
loop "minver::minver_main.L2" { bound: 0 .. 3; }
loop "minver::minver_main.L3" { bound: 0 .. 3; }
loop "minver::minver_main.L4" { bound: 0 .. 3; }

loop "compiler_builtins::mem::memmove.L1" { bound: 0 .. inf; }
loop "compiler_builtins::mem::memmove.L2" { bound: 0 .. inf; }
loop "compiler_builtins::mem::memmove.L3" { bound: 0 .. inf; }
loop "compiler_builtins::mem::memmove.L4" { bound: 0 .. inf; }
loop "compiler_builtins::mem::memmove.L5" { bound: 0 .. inf; }
loop "compiler_builtins::mem::memmove.L6" { bound: 0 .. inf; }
loop "compiler_builtins::mem::memmove.L7" { bound: 0 .. inf; }
loop "compiler_builtins::mem::memmove.L8" { bound: 0 .. inf; }

# code should not panic and as such there should be no need for unwinding
loop "__rustc::rust_begin_unwind.L1" infeasible;
