compiler: "arm-clang";

loop "bitcount_bit_count.L1" { bound: 3 .. 8; }

loop "bitcount_bit_shifter.L1" { bound: 31 .. 31; }

loop "bitcount_main.L1" { bound: 10 .. 10; }
loop "bitcount_main.L2" { bound: 8 .. 8; }

routine "bitcount_ntbl_bitcnt" { recursion bound: 1 .. 8; }
routine "bitcount_btbl_bitcnt" { recursion bound: 1 .. 4; }
