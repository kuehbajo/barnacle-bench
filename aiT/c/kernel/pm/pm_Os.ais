loop "pm_kernel.L5" { bound: 0 .. 64; }
loop "pm_kernel.L6" { bound: 0 .. 60; }
loop "pm_kernel.L7" { bound: 0 .. 63; }
# if
loop "pm_kernel.L10" { bound: 0 .. 21; }
# else
